# Apple Music -> Lidarr bridge configuration.
# Copy to config.env and fill in. Keep config.env private (chmod 600).

# --- Apple Music (from the Apple Developer portal) ---
APPLEMUSIC_TEAM_ID=                    # your 10-char Apple Developer Team ID
APPLEMUSIC_KEY_ID=                     # the 10-char Key ID of your MusicKit private key
APPLEMUSIC_P8_PATH=/data/AuthKey.p8    # the .p8 file, placed in this data/ dir
APPLEMUSIC_STOREFRONT=us               # your Apple Music storefront (auto-detected if wrong)

# Filled in AFTER running --discover (the Favorite Songs playlist id):
FAVORITES_PLAYLIST_ID=

# --- Lidarr ---
LIDARR_URL=http://172.16.238.58:8686
LIDARR_API_KEY=your-lidarr-api-key
LIDARR_QUALITY_PROFILE_ID=2            # 1=Any, 2=Lossless, 3=Standard
LIDARR_METADATA_PROFILE_ID=1           # 1=Standard
LIDARR_ROOT_FOLDER=/music
LIDARR_MONITOR=none                    # how much of a NEW artist to monitor; none = just the favorited album

# --- Behavior ---
POLL_INTERVAL=900                      # seconds between checks (900 = 15 min)
PROCESS_EXISTING=false                 # true = backfill your entire existing favorites on first run
UNMONITOR_ON_REMOVE=true               # un-favorite a song -> un-monitor its album in Lidarr (never deletes files)
MAX_REMOVALS_PER_CYCLE=25              # safety cap: if more favorites than this vanish in one cycle, skip
                                       # un-monitoring (a partial/bad API read shouldn't wipe your monitoring)
NOTIFY_ON_ADD=true                     # send an Apprise "success" notification (naming the matched album) each
                                       # time a favorite is handed to Lidarr; backfill sends one summary instead

# --- MusicBrainz (album resolution) ---
MB_USER_AGENT=applemusic-lidarr/1.0 ( you@example.com )

# --- Notifications (Apprise on Shard) ---
APPRISE_URL=http://172.16.238.45:8000
APPRISE_KEY=media

# --- Web UI (token renewal + no-match repair) ---
WEB_ENABLED=true                       # serve the web UI alongside the poll loop; false = headless as before
WEB_PORT=8080                          # internal port; route to it with Traefik (e.g. applemusic.local). No auth — keep it on a trusted LAN.

LOG_LEVEL=INFO
STATE_DIR=/data

# NOTE: two secrets do NOT live in this file:
#   - the MusicKit private key  -> data/AuthKey.p8
#   - the Music User Token      -> data/mut.txt   (minted via mint_mut.py on your Mac)
